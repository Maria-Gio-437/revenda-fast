{
  "permissions-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|replace_file_content|write_to_file|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/permissions.js"
          }
        ]
      }
    ]
  },
  "auto-lint": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "cd .. && npm run lint"
          }
        ]
      }
    ]
  }
}
